# Copy values in the Supabase Dashboard. Never commit real secrets.

# Edge Function secrets (Project Settings → Edge Functions → Secrets)
# Required. moderate-content will not run without this.
KAIRO_JOB_SECRET=

# Vision / image classification
# sightengine | openai | none
# If unset or none, media stays flagged for admin review.
KAIRO_VISION_PROVIDER=

# Sightengine
KAIRO_VISION_API_USER=
KAIRO_VISION_API_SECRET=

# OpenAI (also used for OCR of text inside images)
# OCR is implemented only when KAIRO_VISION_PROVIDER=openai and this key is set.
# Sightengine has no OCR in this project. No extra OCR provider is invented.
KAIRO_VISION_API_KEY=

# Platform admin alert email is stored in kairo_platform_settings.admin_alert_email
# Set it in SQL after deploy. Do not put a personal address in source files.
# update public.kairo_platform_settings set value = 'admin@example.com' where key = 'admin_alert_email';
KAIRO_ADMIN_ALERT_EMAIL=

# Optional: pg_cron → Edge Function (kairo_platform_settings)
# moderation_worker_url = https://<project>.supabase.co/functions/v1/moderate-content
# moderation_job_secret = same value as KAIRO_JOB_SECRET (or store it in Vault as KAIRO_JOB_SECRET)
# If empty, text-only cron still runs; media waits until the function is invoked.
